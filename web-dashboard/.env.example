# ============================================================
#  Dombla Web Dashboard — Environment Configuration Template
#  Copy this file to .env and fill in your HiveMQ Cloud details.
#  ⚠️ DO NOT COMMIT .env TO GIT!
# ============================================================

# HTTP server port for the dashboard
PORT=8000

# HiveMQ Cloud MQTT Broker URL (TLS port 8883)
# Format: mqtts://<cluster-id>.s1.eu.hivemq.cloud:8883
MQTT_BROKER=mqtts://YOUR_CLUSTER.s1.eu.hivemq.cloud:8883

# HiveMQ Cloud Credentials (created in Access Management)
MQTT_USER=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD

# MQTT Device ID (must match MQTT_DEVICE_ID in esp32-firmware/src/config.h)
MQTT_DEVICE_ID=greenhouse1
